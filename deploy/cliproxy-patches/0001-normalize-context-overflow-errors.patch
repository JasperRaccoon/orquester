+func TestClaudeErrorNormalizesOpenRouterOverflowWithFigures(t *testing.T) {
+	handler := &ClaudeCodeAPIHandler{}
+	msg := &interfaces.ErrorMessage{
+		StatusCode: http.StatusBadRequest,
+		Error:      errors.New(`{"error":{"message":"Provider returned error","code":400,"metadata":{"raw":"{\"error\":{\"message\":\"Invalid request: Your request exceeded model token limit: 1048576 (requested: 1107646)\",\"type\":\"invalid_request_error\"}}","provider_name":"Moonshot AI"}}}`),
+	}
+
+	got := handler.toClaudeError(msg)
+
+	if got.Error.Type != "invalid_request_error" {
+		t.Fatalf("error.type = %q, want invalid_request_error", got.Error.Type)
+	}
+	if got.Error.Message != "prompt is too long: 1107646 tokens > 1048576 maximum" {
+		t.Fatalf("error.message = %q", got.Error.Message)
+	}
+}
+
+func TestClaudeErrorLeavesRateLimitTooManyTokensAlone(t *testing.T) {
+	handler := &ClaudeCodeAPIHandler{}
+	msg := &interfaces.ErrorMessage{
+		StatusCode: http.StatusTooManyRequests,
+		Error:      errors.New(`{"error":{"message":"Rate limit reached: too many tokens per minute, maximum context length notwithstanding","type":"rate_limit_error"}}`),
+	}
+
+	got := handler.toClaudeError(msg)
+
+	if got.Error.Type != "rate_limit_error" {
+		t.Fatalf("error.type = %q, want rate_limit_error", got.Error.Type)
+	}
+	if got.Error.Message == "prompt is too long" {
+		t.Fatal("429 wording must not be rewritten as overflow")
+	}
+}
