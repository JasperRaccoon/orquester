+
+// Claude Code's reactive compact-and-retry recognizes context overflow only
+// when the error message contains "prompt is too long" (or "input is too long
+// for requested model"). Upstream providers word it differently, so an
+// Anthropic-protocol session that hits a provider's context wall fails hard
+// instead of compacting. Rewrite the known overflow signatures to Anthropic's
+// literal phrasing, carrying the figures when the upstream supplies them.
+// 400-class only: 429 "too many tokens per minute" wordings are rate limits,
+// not overflow, and must pass through untouched.
+var (
+	claudeOverflowSignature = regexp.MustCompile(`(?i)exceeds the context window|exceeded model token limit|context_length_exceeded|context_too_large|maximum context length`)
+	claudeOverflowRequested = regexp.MustCompile(`(?i)requested:?\s*(\d+)`)
+	claudeOverflowLimit     = regexp.MustCompile(`(?i)(?:token limit:?|maximum context length(?: is)?:?)\s*(\d+)`)
+)
+
+func normalizeClaudeOverflow(status int, errType, message, rawDetail string) (string, string) {
+	if status != http.StatusBadRequest && status != http.StatusRequestEntityTooLarge {
+		return errType, message
+	}
+	scan := message
+	if rawDetail != "" {
+		scan += "\n" + rawDetail
+	}
+	if !claudeOverflowSignature.MatchString(scan) {
+		return errType, message
+	}
+	requested := claudeOverflowRequested.FindStringSubmatch(scan)
+	limit := claudeOverflowLimit.FindStringSubmatch(scan)
+	if requested != nil && limit != nil {
+		return "invalid_request_error", fmt.Sprintf("prompt is too long: %s tokens > %s maximum", requested[1], limit[1])
+	}
+	return "invalid_request_error", "prompt is too long"
 }
 
