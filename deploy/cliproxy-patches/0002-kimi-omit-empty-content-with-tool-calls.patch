+
+func TestConvertClaudeRequestToOpenAIOmitsEmptyContentForKimiBareToolCall(t *testing.T) {
+	input := []byte(`{"model":"kimi-k3","messages":[{"role":"assistant","content":[{"type":"tool_use","id":"call_1","name":"read","input":{"path":"a.txt"}}]},{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_1","content":"data"}]}]}`)
+
+	out := ConvertClaudeRequestToOpenAI("moonshotai/kimi-k3", input, false)
+
+	messages := gjson.GetBytes(out, "messages").Array()
+	if len(messages) < 2 {
+		t.Fatalf("expected >=2 messages, got %d: %s", len(messages), out)
+	}
+	assistant := messages[0]
+	if assistant.Get("role").String() != "assistant" || !assistant.Get("tool_calls").Exists() {
+		t.Fatalf("messages[0] should be assistant with tool_calls: %s", assistant.Raw)
+	}
+	if assistant.Get("content").Exists() {
+		t.Fatalf("kimi bare tool-call turn must OMIT content, got: %s", assistant.Raw)
+	}
+}
+
+func TestConvertClaudeRequestToOpenAIKeepsEmptyContentForOtherModels(t *testing.T) {
+	input := []byte(`{"model":"gpt-5.6-sol","messages":[{"role":"assistant","content":[{"type":"tool_use","id":"call_1","name":"read","input":{"path":"a.txt"}}]}]}`)
+
+	out := ConvertClaudeRequestToOpenAI("gpt-5.6-sol", input, false)
+
+	assistant := gjson.GetBytes(out, "messages").Array()[0]
+	if !assistant.Get("content").Exists() || assistant.Get("content").String() != "" {
+		t.Fatalf("non-kimi models keep the empty content field, got: %s", assistant.Raw)
+	}
+}
