# Copy to /etc/orquester/daemon.env (chmod 600, owned by the orquester user).
# Never commit the real file — only this example.
#
# NOTE: systemd's EnvironmentFile only treats `#` as a comment at the START of a
# line — an inline `KEY=value  # note` makes the note part of the VALUE. Keep
# every comment on its own line. (A trailing comment on HOME= once set HOME to
# "/var/lib/orquester   # pin HOME so git…", and the daemon died in a restart
# loop with EACCES mkdir on that literal path.)
ORQUESTER_HTTP_ENABLED=true
# localhost ONLY — Caddy is the public face
ORQUESTER_HTTP_HOST=127.0.0.1
ORQUESTER_HTTP_PORT=47831
# Generate with: openssl rand -base64 32
ORQUESTER_HTTP_PASSWORD=replace-with-a-32+char-random-secret
ORQUESTER_HTTP_USERNAME=mapacho
ORQUESTER_WEB_DIR=/opt/orquester/apps/web/dist
# The previous release's web build (/opt/orquester-previous is kept by every deploy). Pages opened
# before an update lazily load hashed chunks the new build no longer has; the daemon serves those
# from here (index.html and unhashed files always come from ORQUESTER_WEB_DIR). ./deploy.sh
# provision and deploy add this line when it is missing; they never change an existing value
# (set it empty to turn the fallback off).
ORQUESTER_WEB_FALLBACK_DIR=/opt/orquester-previous/apps/web/dist
# The daemon's public HTTPS origin (Caddy's domain). Ephemeral AI VMs dial it: it is the
# default Public URL in Settings → Plugins → Ephemeral AI VMs → Connection, and macOS boxes
# (GitHub Actions runners) use it even in Tailscale mode. ./deploy.sh provision and deploy add
# it from the target's `domain` when this line is missing; they never change an existing value.
# ORQUESTER_PUBLIC_URL=https://orquester.example.com
# pin HOME so git/ssh + the tsx transpile cache resolve under the appdir
HOME=/var/lib/orquester
