[Unit]
Description=Orquester self-update (the deploy update cycle, on the daemon's request)
# Started only by orquester-update.path, when the daemon creates its update request
# (POST /api/self-update); there is no [Install] section. A separate unit, so it runs outside
# orquester.service's cgroup: the `systemctl restart orquester` it performs does not stop it.

# A request left from before a reboot starts the update at boot: it fetches, so wait for the network.
After=network-online.target
Wants=network-online.target

[Service]
# Root, unsandboxed: the update builds the next release in root-owned /opt/orquester-releases and
# points /opt/orquester at it (an install not converted yet: rewrites the checkout there), installs
# into /usr/local and /etc (Go, voxl, the units) and restarts orquester. The daemon user only
# creates the request file, whose content is ignored; the branch is fixed here, so the request
# cannot steer anything.
Type=oneshot
# The default RemainAfterExit=no: the unit goes inactive when the run ends, so the path unit can
# start the next requested run. The default KillMode=control-group: when the run ends (or the unit
# is stopped), whatever it left in its own cgroup is killed; the daemon it restarted lives in
# orquester.service's cgroup and is not affected.
# A git@ origin authenticates with root's ssh key.
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=REQUEST_FILE=/var/lib/orquester/daemon/update-request
# Root writes only into its own directory (root-owned, world-readable: the daemon reads the status
# at ORQUESTER_SELF_UPDATE_STATUS), never into one the daemon user controls.
Environment=STATUS_FILE=/var/lib/orquester-update/status.json
Environment=UPDATE_SCRIPT=/run/orquester-update/remote-update.sh
Environment=BRANCH=main
RuntimeDirectory=orquester-update
StateDirectory=orquester-update
StateDirectoryMode=0755
# The request goes first, whatever happens next: the path unit (PathExists=) would start this unit
# again and again while it exists. self-update.sh removes it too.
ExecStartPre=-/usr/bin/rm -f ${REQUEST_FILE}
# Run copies: bash reads a script while it runs it, and the update moves /opt/orquester (or rewrites
# a plain checkout) under it. Each comes from /opt/orquester-releases/tooling/, where every
# successful layout-aware update installs its own scripts — so after a rollback to a release from
# before the release layout, self-update still runs layout-aware tooling — and, on a host without
# it (not converted yet), from the live release (install follows the /opt/orquester symlink). The
# wrapper is copied last, so its copy exists only when both did.
ExecStartPre=/bin/bash -c 'src=/opt/orquester-releases/tooling/$$1; [ -f "$$src" ] || src=/opt/orquester/deploy/lib/$$1; exec /usr/bin/install -m 0700 "$$src" /run/orquester-update/' copy-tool remote-update.sh
ExecStartPre=/bin/bash -c 'src=/opt/orquester-releases/tooling/$$1; [ -f "$$src" ] || src=/opt/orquester/deploy/lib/$$1; exec /usr/bin/install -m 0700 "$$src" /run/orquester-update/' copy-tool self-update.sh
ExecStart=/bin/bash /run/orquester-update/self-update.sh
# When a copy failed (a checkout without self-update.sh), the wrapper never ran: record a failed run
# from the live release's HEAD (git -C follows the symlink into its worktree) so the daemon stops
# waiting. Once the wrapper ran, it recorded the outcome itself. ($$ and %% are systemd's escapes for $ and %; the JSON formats are the last two words.)
ExecStopPost=/bin/bash -c 'test -e /run/orquester-update/self-update.sh && exit 0; t=$$(date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ); f=$$(git -C /opt/orquester rev-parse HEAD 2>/dev/null) || f=; if [ $${#f} -eq 40 ]; then printf "$$1" "$$f" "$$t" "$$t"; else printf "$$2" "$$t" "$$t"; fi > "$$STATUS_FILE.tmp" && chmod 0644 "$$STATUS_FILE.tmp" && mv -f "$$STATUS_FILE.tmp" "$$STATUS_FILE"' self-update-fallback '{"state":"failed","from":"%%s","startedAt":"%%s","finishedAt":"%%s","exitCode":1}' '{"state":"failed","from":null,"startedAt":"%%s","finishedAt":"%%s","exitCode":1}'
# A build can take many minutes, the health check waits up to 10 more, and a revert repeats both.
# Finite, so a hung fetch or install is killed (the wrapper's TERM trap records it as failed) — and
# below the daemon's 3 h STALE_RUN_MS, so the daemon never accepts a new request while this still runs.
TimeoutStartSec=2h
