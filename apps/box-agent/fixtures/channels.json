{
  "exec": [
    {
      "kind": "exec",
      "command": "git",
      "args": [
        "status",
        "--short"
      ]
    },
    {
      "kind": "exec",
      "command": "claude",
      "args": [
        "--print"
      ],
      "cwd": "/srv/p",
      "env": {
        "CLAUDE_CONFIG_DIR": "/home/dev/.claude"
      },
      "envUnset": [
        "NODE_OPTIONS"
      ],
      "pty": {
        "cols": 80,
        "rows": 24,
        "term": "xterm-256color"
      },
      "detach": {
        "procId": "proc-1",
        "bufferBytes": 1048576
      },
      "shell": false
    },
    {
      "kind": "exec",
      "command": "echo hi && exit 3",
      "args": [],
      "shell": true,
      "pty": {
        "cols": 100,
        "rows": 30
      },
      "detach": {
        "procId": "proc-2"
      }
    }
  ],
  "attach": [
    {
      "kind": "attach",
      "procId": "proc-1",
      "fromOffset": 0
    },
    {
      "kind": "attach",
      "procId": "proc-1",
      "fromOffset": 4096
    }
  ],
  "tcp": [
    {
      "kind": "tcp",
      "port": 3000
    },
    {
      "kind": "tcp",
      "host": "10.0.0.2",
      "port": 5432
    }
  ],
  "unix": [
    {
      "kind": "unix",
      "path": "/home/dev/.orq-agent/desktops/d1/vnc.sock"
    }
  ],
  "host-tcp": [
    {
      "kind": "host-tcp",
      "target": "mcp:abc",
      "boxPort": 40123
    }
  ],
  "file-read": [
    {
      "kind": "file-read",
      "path": "/srv/p/a.bin"
    },
    {
      "kind": "file-read",
      "path": "/srv/p/a.bin",
      "offset": 0,
      "length": 4096
    }
  ],
  "file-write": [
    {
      "kind": "file-write",
      "path": "/srv/p/out.txt"
    },
    {
      "kind": "file-write",
      "path": "/srv/p/out.txt",
      "mode": 384,
      "mkdirs": true,
      "append": false
    }
  ],
  "tar-read": [
    {
      "kind": "tar-read",
      "path": "/srv/p"
    },
    {
      "kind": "tar-read",
      "path": "/srv/p",
      "exclude": [
        "node_modules",
        "*.log"
      ]
    }
  ],
  "tar-write": [
    {
      "kind": "tar-write",
      "path": "/srv/q"
    },
    {
      "kind": "tar-write",
      "path": "/srv/q",
      "compression": "gzip"
    }
  ],
  "ssh-agent": [
    {
      "kind": "ssh-agent"
    }
  ],
  "mcp-bridge": [
    {
      "kind": "mcp-bridge",
      "serverId": "github"
    }
  ]
}
