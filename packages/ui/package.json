    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@orquester/api": "workspace:*",
    "@orquester/config": "workspace:*",
    "@orquester/registry": "workspace:*",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuzzysort": "^3.1.0",
