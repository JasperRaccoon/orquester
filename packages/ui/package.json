    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@excalidraw/excalidraw": "0.18.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@novnc/novnc": "1.7.0",
    "@orquester/api": "workspace:*",
    "@orquester/config": "workspace:*",
    "@orquester/registry": "workspace:*",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "cronstrue": "^3.27.0",
    "cytoscape": "3.34.3",
    "cytoscape-fcose": "2.2.0",
    "dompurify": "^3.4.17",
    "fuzzysort": "^3.1.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "opus-decoder": "0.7.12",
    "pdfjs-dist": "^4.7.76",
    "pele": "1.9.0",
    "postcss": "^8.5.15",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
